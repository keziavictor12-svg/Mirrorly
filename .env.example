# Copy the lines you need into .env.local (git-ignored). Never commit real values.

# OpenAI image edits for "Create AI hair for live AR" and "See realistic result" (salon result).
OPENAI_API_KEY=

# Snap Camera Kit live mirror (https://my-lenses.snapchat.com/camera-kit).
SNAP_CAMERA_KIT_API_TOKEN=
# One or more Lens Group IDs, comma separated.
SNAP_LENS_GROUP_ID=
# Optional. Without it, name lenses after styles: bob, feather, v-cut, u-cut,
# crew-cut, buzz-cut, curtain-bangs, skin-fade (or e.g. bob-golden-blonde).
# SNAP_LENS_MAP={"bob":"<lens-id>","bob:Copper":"<lens-id>"}
